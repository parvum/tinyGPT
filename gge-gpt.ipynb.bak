{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyNhTN5mg2hGK+VJsi5JJVoY"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["***This is my GPT implementation***"],"metadata":{"id":"btm1z5qZYXjD"}},{"cell_type":"code","source":["import torch\n","import torch.nn as nn\n","from torch.nn import functional as F\n","from collections import OrderedDict"],"metadata":{"id":"ryGdJteI1-VE","executionInfo":{"status":"ok","timestamp":1716514700120,"user_tz":240,"elapsed":3500,"user":{"displayName":"Guangtao ge","userId":"15141874840943179622"}}},"execution_count":3,"outputs":[]},{"cell_type":"code","source":["batch_size = 16\n","block_size = 32\n","emb_dim = 64\n","n_head = 4\n","n_layer = 4\n","dropout = 0.0\n","\n","max_iters = 10000\n","eval_interval = 100\n","learning_rate = 1e-3\n","eval_iters = 200\n","\n","device = 'cuda' if torch.cuda.is_available() else 'cpu'"],"metadata":{"id":"dkGh0FtX44Wm","executionInfo":{"status":"ok","timestamp":1716514703279,"user_tz":240,"elapsed":175,"user":{"displayName":"Guangtao ge","userId":"15141874840943179622"}}},"execution_count":4,"outputs":[]},{"cell_type":"code","source":["def get_batch(split):\n","    # generate a small batch of data of inputs x and targets y\n","    data = train_data if split == 'train' else val_data\n","    ix = torch.randint(len(data) - block_size, (batch_size,))\n","    x = torch.stack([data[i:i+block_size] for i in ix])\n","    y = torch.stack([data[i+1:i+block_size+1] for i in ix])\n","    x, y = x.to(device), y.to(device)\n","    return x, y\n","\n","@torch.no_grad()\n","def estimate_loss():\n","    out = {}\n","    model.eval()\n","    for split in ['train', 'val']:\n","        losses = torch.zeros(eval_iters)\n","        for k in range(eval_iters):\n","            X, Y = get_batch(split)\n","            logits, loss = model(X, Y)\n","            losses[k] = loss.item()\n","        out[split] = losses.mean()\n","    model.train()\n","    return out"],"metadata":{"id":"JwZa4k9hPhix","executionInfo":{"status":"ok","timestamp":1716514705707,"user_tz":240,"elapsed":168,"user":{"displayName":"Guangtao ge","userId":"15141874840943179622"}}},"execution_count":5,"outputs":[]},{"cell_type":"code","source":["torch.manual_seed(1337)\n","\n","!wget https://raw.githubusercontent.com/karpathy/char-rnn/master/data/tinyshakespeare/input.txt\n","with open('input.txt', 'r', encoding='utf-8') as f:\n","    text = f.read()\n","\n","# here are all the unique characters that occur in this text\n","chars = sorted(list(set(text)))\n","vocab_size = len(chars)\n","# create a mapping from characters to integers\n","stoi = { ch:i for i,ch in enumerate(chars) }\n","itos = { i:ch for i,ch in enumerate(chars) }\n","encode = lambda s: [stoi[c] for c in s] # encoder: take a string, output a list of integers\n","decode = lambda l: ''.join([itos[i] for i in l]) # decoder: take a list of integers, output a string\n","\n","# Train and test splits\n","data = torch.tensor(encode(text), dtype=torch.long)\n","n = int(0.9*len(data)) # first 90% will be train, rest val\n","train_data = data[:n]\n","val_data = data[n:]"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Yzavb_nANEOz","executionInfo":{"status":"ok","timestamp":1716514709490,"user_tz":240,"elapsed":1043,"user":{"displayName":"Guangtao ge","userId":"15141874840943179622"}},"outputId":"44139c64-1998-4d88-8b2d-f8454038784f"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["--2024-05-24 01:38:28--  https://raw.githubusercontent.com/karpathy/char-rnn/master/data/tinyshakespeare/input.txt\n","Resolving raw.githubusercontent.com (raw.githubusercontent.com)... 185.199.108.133, 185.199.109.133, 185.199.110.133, ...\n","Connecting to raw.githubusercontent.com (raw.githubusercontent.com)|185.199.108.133|:443... connected.\n","HTTP request sent, awaiting response... 200 OK\n","Length: 1115394 (1.1M) [text/plain]\n","Saving to: ‘input.txt’\n","\n","\rinput.txt             0%[                    ]       0  --.-KB/s               \rinput.txt           100%[===================>]   1.06M  --.-KB/s    in 0.05s   \n","\n","2024-05-24 01:38:28 (22.8 MB/s) - ‘input.txt’ saved [1115394/1115394]\n","\n"]}]},{"cell_type":"markdown","source":[],"metadata":{"id":"C38fRnUmXjxx"}},{"cell_type":"code","execution_count":15,"metadata":{"id":"09dVReBY03io","executionInfo":{"status":"ok","timestamp":1716517071159,"user_tz":240,"elapsed":159,"user":{"displayName":"Guangtao ge","userId":"15141874840943179622"}}},"outputs":[],"source":["class AttentionHead(nn.Module):\n","    \"\"\"Individual attention head\"\"\"\n","    def __init__(self, head_size):\n","        super().__init__()\n","        # this place, why it is head size, some other places use emb_dim\n","        self.key = nn.Linear(emb_dim, head_size, bias=False)\n","        self.query = nn.Linear(emb_dim, head_size, bias=False)\n","        self.value = nn.Linear(emb_dim, head_size, bias=False)\n","        self.register_buffer('tril', torch.tril(torch.ones(block_size, block_size)))\n","        self.dropout = nn.Dropout(dropout)\n","\n","    def forward(self, x):\n","        B,T,C = x.shape\n","        k = self.key(x)   # (B,T,C)\n","        q = self.query(x) # (B,T,C)\n","        # computer attention score\n","        weight = q @ k.transpose(-2, -1) * C**-0.5 # (B, T, C) @ (B, C, T) -> (B, T, T) and also a normalization factor here\n","        weight = weight.masked_fill(self.tril[:T, :T] == 0, float('-inf')) # (B, T, T)\n","        weight = F.softmax(weight, dim=-1) # (B, T, T)\n","        weight = self.dropout(weight)\n","        v = self.value(x) # (B,T,C)\n","        out = weight @ v # (B, T, T) @ (B, T, C) -> (B, T, C)\n","        return out\n","\n","class MultiAttentionHead(nn.Module):\n","    \"\"\"A simple multi head attention layer\"\"\"\n","    def __init__(self, num_head, head_size):\n","        super().__init__()\n","        self.heads = nn.ModuleList([AttentionHead(head_size) for _ in range(num_head)])\n","        self.projection = nn.Linear(emb_dim, emb_dim)\n","        self.dropout = nn.Dropout(dropout)\n","\n","    def forward(self, x):\n","        x = torch.cat([h(x) for h in self.heads], dim=-1) # concatenate all heads, (B,T,C/num_head) for each head\n","        x = self.dropout(self.projection(x))\n","        return x\n","\n","class FeedForward(nn.Module):\n","    \"\"\"A simple linear layer with 4 components\"\"\"\n","    def __init__(self, emb_dim):\n","        super().__init__()\n","        # why it is 4 * emb_dim\n","        self.net = nn.Sequential(\n","            nn.Linear(emb_dim, 4 * emb_dim),\n","            nn.ReLU(),\n","            nn.Linear(4 * emb_dim, emb_dim),\n","            nn.Dropout(dropout)\n","        )\n","\n","    def forward(self, x):\n","        return self.net(x)\n","\n","\n","class Block(nn.Module):\n","    \"\"\"Transformer block\"\"\"\n","    def __init__(self, emb_dim, n_head):\n","        # One block will consists a multihead attention layer, a feed forward layer, two layer norm\n","        super().__init__()\n","        head_size = emb_dim // n_head\n","        self.mha = MultiAttentionHead(n_head, head_size)\n","        self.ff = FeedForward(emb_dim)\n","        self.ln1 = nn.LayerNorm(emb_dim)\n","        self.ln2 = nn.LayerNorm(emb_dim)\n","\n","    def forward(self, x):\n","        # I guess here is the kaiming thing to prevent residuals doing too small or too big\n","        x = x + self.mha(self.ln1(x))\n","        x = x + self.ff(self.ln2(x))\n","        return x\n","\n","\n","class tinyGPT(nn.Module):\n","\n","    def __init__(self):\n","        super().__init__()\n","        # Token Embedding table is just a lookup table\n","        # https://pytorch.org/docs/stable/generated/torch.nn.Embedding.html,\n","        # I guess the __call__ method takes a 2D array, likely B, T and return (B, T, C) with C is the dimension\n","        # Batch normalization normalizes each feature independently across the mini-batch.\n","        # Layer normalization normalizes each of the inputs in the batch independently across all features.\n","        self.tok_embedding_table = nn.Embedding(vocab_size, emb_dim)\n","        # Positional Embedding and why it is only using block_size, likely takes a T and returns (T, C)\n","        self.pos_embedding_table = nn.Embedding(block_size, emb_dim)\n","        # Blocks, a couple of blocks chained together\n","        self.Blocks = nn.Sequential(*[Block(emb_dim, n_head) for _ in range(n_layer)])\n","        self.ln_f = nn.LayerNorm(emb_dim)\n","        self.lm_head = nn.Linear(emb_dim, vocab_size)\n","        # so a couple of blocks, then a layer norm, then a linear head\n","\n","    def forward(self, idx, targets=None):\n","        B,T = idx.shape\n","        tok_emb = self.tok_embedding_table(idx) # (B,T,C)\n","        pos_emb = self.pos_embedding_table(torch.arange(T, device=device)) # (T,C) what is arrange, why cannot use T, maybe ut becomes a (1,T) array\n","        x = tok_emb + pos_emb # (B,T,C)\n","        x = self.Blocks(x) # (B,T,C)\n","        x = self.ln_f(x) # (B,T,C)\n","        logits = self.lm_head(x) # (B,T,vocab_size)\n","\n","        if targets == None:\n","            loss = None\n","        else:\n","            B,T,C = logits.shape\n","            logits = logits.view(B*T, C)\n","            targets = targets.view(B*T)\n","            loss = F.cross_entropy(logits, targets)\n","        return logits, loss\n","\n","    def generate(self, idx, max_new_tokens, temperature=1.0):\n","        # idx is (B, T) array of indices in the current context\n","        for _ in range(max_new_tokens):\n","            # only use the tokens up to the last block, that is only look at the block size history\n","            assert idx_cond.shape[1] > block_size\n","            idx_cond = idx[:, -block_size:]\n","            # get the predictions\n","            logits, loss = self(idx_cond)\n","            # focus only on the last time step and scale by the desired temperature.\n","            logits = logits[:, -1, :] / temperature # becomes (B, C)\n","            # apply softmax to get probabilities\n","            probs = F.softmax(logits, dim=-1) # (B, C)\n","            # sample from the distribution\n","            idx_next = torch.multinomial(probs, num_samples=1) # (B, 1)\n","            # append sampled index to the running sequence\n","            idx = torch.cat((idx, idx_next), dim=1) # (B, T+1)\n","        return idx\n","\n","    def parameter_count(self):\n","\n","        param_num = OrderedDict()\n","        # embedding layer\n","        param_num[\"embedding_tok\"] = vocab_size * emb_dim\n","        param_num[\"embedding_pos\"] = block_size * emb_dim\n","        param_num[\"embedding\"] = param_num[\"embedding_tok\"] + param_num[\"embedding_pos\"]\n","        # attention layer\n","        param_num[\"attention_qkv\"] = emb_dim * 3 * emb_dim\n","        param_num[\"attention_prj\"] = emb_dim * emb_dim\n","        param_num[\"attention\"] = param_num[\"attention_qkv\"] + param_num[\"attention_prj\"]\n","        # mlp layer\n","        param_num[\"mlp_feedforward\"] = emb_dim * 4 * emb_dim * 2\n","        param_num[\"mlp\"] = param_num[\"mlp_feedforward\"]\n","\n","        param_num['block'] = param_num['attention'] + param_num['mlp']\n","        param_num['transformer'] = n_layer * param_num['block']\n","        param_num['ln_f'] = emb_dim # final layernorm\n","        param_num['dense'] = emb_dim * vocab_size # 0 because of parameter sharing. This layer uses the weights from the embedding layer\n","\n","        # total\n","        param_num['total'] = param_num['embedding'] + param_num['transformer'] + param_num['ln_f'] + param_num['dense']\n","        return param_num"]},{"cell_type":"code","source":["model = tinyGPT()\n","m = model.to(device)\n","# print the number of parameters in the model\n","print(sum(p.numel() for p in m.parameters()), 'parameters')\n","param_num = m.parameter_count()\n","print(param_num[\"total\"], 'parameters')\n","print(param_num)\n","# create a PyTorch optimizer, here is a simple call, but actually it really needs customized.\n","optimizer = torch.optim.AdamW(model.parameters(), lr=learning_rate)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"2tkQUToS_A8N","executionInfo":{"status":"ok","timestamp":1716517073797,"user_tz":240,"elapsed":177,"user":{"displayName":"Guangtao ge","userId":"15141874840943179622"}},"outputId":"636e9182-f38b-4aaf-ef09-6e674880783b"},"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["209729 parameters\n","207040 parameters\n","OrderedDict([('embedding_tok', 4160), ('embedding_pos', 2048), ('embedding', 6208), ('attention_qkv', 12288), ('attention_prj', 4096), ('attention', 16384), ('mlp_feedforward', 32768), ('mlp', 32768), ('block', 49152), ('transformer', 196608), ('ln_f', 64), ('dense', 4160), ('total', 207040)])\n"]}]},{"cell_type":"code","source":["\n","\n","for iter in range(max_iters):\n","\n","    # every once in a while evaluate the loss on train and val sets\n","    if iter % eval_interval == 0 or iter == max_iters - 1:\n","        losses = estimate_loss()\n","        print(f\"step {iter}: train loss {losses['train']:.4f}, val loss {losses['val']:.4f}\")\n","\n","    # sample a batch of data\n","    xb, yb = get_batch('train')\n","\n","    # evaluate the loss\n","    logits, loss = model(xb, yb)\n","    optimizer.zero_grad(set_to_none=True)\n","    loss.backward()\n","    optimizer.step()\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"xPsHPwZIP-_Y","executionInfo":{"status":"ok","timestamp":1715954349459,"user_tz":240,"elapsed":1067685,"user":{"displayName":"Guangtao ge","userId":"15141874840943179622"}},"outputId":"aff7d2a5-eed9-402b-8415-4531cf583d89"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdo